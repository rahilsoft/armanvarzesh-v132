{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // This package is a Vite/React SPA: index.html + vite.config.ts + src/index.tsx,
    // with vite and react as dependencies and no @nestjs/core. Vite produces the
    // bundle, so tsc's job here is purely to typecheck.
    //
    // Everything else is inherited. This file used to re-declare module,
    // moduleResolution, baseUrl, target, paths, include and exclude, and each
    // override broke the app it was meant to build:
    //   module: CommonJS          -> TS1343 on every import.meta.env
    //   baseUrl: "." + own paths  -> dropped "@graphql/*", so 24 imports went unresolved
    //   own exclude list          -> re-included src/main.ts, a NestJS entrypoint the
    //                                parent deliberately excludes (it imports
    //                                ./app.module, which does not exist, and
    //                                @arman/nest-bootstrap, which is not a dependency)
    "noEmit": true
  }
}
